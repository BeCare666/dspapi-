# --- TiDB Cloud ---
TIDB_CLOUD_API_PUBLIC_KEY=
TIDB_CLOUD_API_PRIVATE_KEY=
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DBNAME?sslaccept=strict"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo ---
BREVO_API_KEY=
# Dev/test : adresse personnelle acceptee (validee comme expediteur dans Brevo).
# A remplacer par une adresse pro sur domaine propre en production.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DSP

# --- KKiaPay ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# --- App ---
NODE_ENV=development
PORT=3001
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Seed (optionnel — sinon email par défaut + mot de passe généré à la volée) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
